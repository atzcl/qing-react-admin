{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "react-compiler-excluded/**/*.ts",
    "react-compiler-excluded/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"]
    },
    "types": ["vite/client", "vitest/globals"]
  }
}
