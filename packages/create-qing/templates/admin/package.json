{
  "name": "__PROJECT_NAME__",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-only React 19 administration workspace with TanStack Router and Ant Design 6.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter __PACKAGE_NAME__ build",
    "check": "pnpm routes:check && pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm typecheck:compat && pnpm test && pnpm test:coverage && pnpm skills:validate",
    "dev": "pnpm --filter __PACKAGE_NAME__ dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "generate": "node tools/generator/bin/qing-react-generate.mjs",
    "lint": "oxlint .",
    "preview": "pnpm --filter __PACKAGE_NAME__ preview",
    "routes:check": "node scripts/generate-admin-routes.mjs --check",
    "routes:generate": "node scripts/generate-admin-routes.mjs",
    "skills:validate": "node scripts/validate-skills.mjs",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "playwright test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present run typecheck",
    "typecheck:compat": "pnpm -r --if-present run typecheck:compat",
    "typecheck:native": "pnpm -r --if-present run typecheck:native"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=24.20.0",
    "pnpm": ">=12.2.1"
  },
  "packageManager": "pnpm@12.2.1"
}
